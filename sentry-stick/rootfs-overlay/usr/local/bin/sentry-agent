#!/usr/bin/env python3
"""
sentry-agent: UAI bridge running inside the Alpine rescue environment.

Auth model (Axiom-inspired, two paths):
  Level 2  — Axiom session token: Authorization: Axiom <16-byte-hex>
               Obtained via GET /challenge → POST /handshake.
               Ed25519 node identity; HMAC session tokens, 15-min TTL, rotating.
  Fallback — Pre-shared bearer: Authorization: Bearer <token>
               Set in engagement.yaml auth.token. Simpler but no node identity.

Unauthenticated endpoints:
  GET /health       liveness only
  GET /challenge    starts Axiom handshake (returns nonce + pubkey)
  POST /handshake   completes handshake (returns session token)
"""

import hashlib
import ipaddress
import json
import os
import re
import secrets
import socket
import subprocess
import sys
import time
import threading
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.request import urlopen, Request

sys.path.insert(0, "/usr/local/lib")
from sentry.trust import (
    load_or_generate_identity,
    load_or_generate_session_secret,
    issue_challenge,
    complete_handshake,
    validate_session,
    session_needs_refresh,
)

# ── config ────────────────────────────────────────────────────────────────────
UAI_BROKER   = os.environ.get("UAI_BROKER", "")
AGENT_PORT   = int(os.environ.get("SENTRY_AGENT_PORT", "7800"))
TOKEN_FILE   = "/etc/sentry/agent.token"
LEVEL_FILE   = "/etc/sentry/auth.level"
SUBNET_FILE  = "/etc/sentry/allowed_subnets"
STATUS_FILE  = "/boot/cfg/STATUS.TXT"

# Read-only diagnostic command allowlist for the 'run' action.
_RUN_ALLOWLIST = frozenset([
    "lsblk", "blkid", "lscpu", "free", "df", "du",
    "lspci", "lsusb", "dmidecode",
    "hdparm -I", "hdparm -C",
    "smartctl -H", "smartctl -i", "smartctl -a", "smartctl -A", "smartctl -l",
    "ip addr", "ip link", "ip route", "ip -4", "ip -6",
    "ss -tulpn", "ss -s",
    "ps", "top -b -n1", "dmesg",
    "ls", "cat /proc", "cat /sys", "cat /etc/os-release",
    "uname", "hostname", "date", "uptime",
    "efibootmgr", "nvme list", "nvme smart-log",
    "mount", "findmnt", "stat",
    "rc-status",
])

# ── node identity & session state (set in main) ───────────────────────────────
_PRIVKEY       = None
_PUBKEY_HEX    = None
_SESSION_SEC   = None
_BEARER_TOKEN  = None
_SUBNETS: list = []


# ── helpers ───────────────────────────────────────────────────────────────────

def _sh(cmd, timeout=15):
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)
        return r.stdout.strip()
    except Exception as e:
        return f"ERROR: {e}"


def _hostname():
    try:
        return open("/etc/hostname").read().strip()
    except Exception:
        return socket.gethostname()


def _my_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        return s.getsockname()[0]
    except Exception:
        return "unknown"


def _auth_level():
    try:
        return open(LEVEL_FILE).read().strip()
    except Exception:
        return "passive"


def _is_run_allowed(cmd: str) -> bool:
    c = cmd.strip().lstrip("/")
    for a in _RUN_ALLOWLIST:
        if c == a or c.startswith(a + " "):
            return True
    return False


def _disks():
    out = _sh("lsblk -J -o NAME,SIZE,TYPE,MOUNTPOINT,LABEL,FSTYPE,MODEL 2>/dev/null")
    try:
        return json.loads(out).get("blockdevices", [])
    except Exception:
        return []


def _smart(device):
    if not re.match(r"^/dev/[a-z0-9]+$", device):
        return "ERROR: invalid device path"
    return _sh(f"smartctl -H -i {device} 2>/dev/null")


def _boot_envs():
    out = _sh("efibootmgr -v 2>/dev/null")
    entries = []
    for line in out.splitlines():
        if line.startswith("Boot") and "* " in line:
            parts = line.split("* ", 1)
            num  = parts[0].replace("Boot", "").strip()
            name = (parts[1].split("\t")[0] if "\t" in parts[1] else parts[1][:40]).strip()
            entries.append({"id": num, "name": name, "active": True})
        elif line.startswith("Boot") and line[8:9] == " ":
            entries.append({"id": line[4:8], "name": line[9:50].strip(), "active": False})
    return entries


def _full_state():
    return {
        "hostname":    _hostname(),
        "ip":          _my_ip(),
        "mode":        "rescue",
        "auth_level":  _auth_level(),
        "node_pubkey": _PUBKEY_HEX or "",
        "uptime_sec":  int(_sh("awk '{print int($1)}' /proc/uptime") or 0),
        "cpu":         _sh("grep 'model name' /proc/cpuinfo | head -1 | cut -d: -f2").strip(),
        "ram_mb":      int(_sh("awk '/MemTotal/{print int($2/1024)}' /proc/meminfo") or 0),
        "kernel":      _sh("uname -r"),
        "disks":       _disks(),
        "boot_envs":   _boot_envs(),
        "pci_summary": _sh("lspci 2>/dev/null | grep -iE 'VGA|SATA|NVMe|Ethernet|Network'"),
        "network": {
            "interface": _sh("ip -4 route show default | awk '/default/{print $5}' | head -1"),
            "ip":        _my_ip(),
            "gateway":   _sh("ip -4 route show default | awk '/default/{print $3}' | head -1"),
        },
    }


# ── auth ──────────────────────────────────────────────────────────────────────

def _check_ip(client_ip: str) -> tuple[bool, str]:
    if not _SUBNETS:
        return True, ""
    try:
        addr = ipaddress.ip_address(client_ip)
        if any(addr in net for net in _SUBNETS):
            return True, ""
        return False, f"IP {client_ip} not in allowed_subnets"
    except ValueError:
        return False, f"invalid client IP {client_ip}"


def _check_auth(handler) -> tuple[bool, str, str | None]:
    """
    Returns (ok, error_msg, session_token_if_axiom).
    Accepts:
      Authorization: Axiom <session_token>   ← preferred
      Authorization: Bearer <bearer_token>   ← fallback
    """
    ok, msg = _check_ip(handler.client_address[0])
    if not ok:
        return False, msg, None

    hdr = handler.headers.get("Authorization", "")

    if hdr.startswith("Axiom "):
        token = hdr[6:].strip()
        ok, detail = validate_session(token)
        if ok:
            return True, "", token
        return False, f"Axiom session: {detail}", None

    if hdr.startswith("Bearer "):
        if _BEARER_TOKEN and secrets.compare_digest(hdr[7:].strip(), _BEARER_TOKEN):
            return True, "", None
        return False, "Bearer token invalid", None

    return False, "missing Authorization header (Axiom or Bearer)", None


# ── actions ───────────────────────────────────────────────────────────────────

def _do_action(body: dict) -> dict:
    action = body.get("action", "")
    level  = _auth_level()

    def need_scanning():
        if level != "scanning":
            return {"ok": False, "error": f"{action!r} requires scanning level, have {level!r}"}
        return None

    if action == "state":
        return {"ok": True, "state": _full_state()}

    if action == "disk_list":
        return {"ok": True, "disks": _disks()}

    if action == "smart":
        dev = body.get("device", "")
        if not dev:
            return {"ok": False, "error": "missing device"}
        return {"ok": True, "output": _smart(dev)}

    if action == "boot_envs":
        return {"ok": True, "boot_envs": _boot_envs()}

    if action == "run":
        err = need_scanning()
        if err:
            return err
        cmd = body.get("cmd", "")
        if not cmd:
            return {"ok": False, "error": "missing cmd"}
        if not _is_run_allowed(cmd):
            return {"ok": False, "error": f"not in allowlist: {cmd!r}",
                    "hint": "only read-only diagnostic commands permitted"}
        return {"ok": True, "output": _sh(cmd, timeout=30)}

    if action == "reboot_to_os":
        entries = _boot_envs()
        target = next(
            (e["id"] for e in entries if "sentry" not in e.get("name","").lower() and e.get("active")),
            None,
        )
        if not target:
            return {"ok": False, "error": "no non-sentry EFI boot entry found"}
        _sh(f"efibootmgr -n {target}")
        threading.Timer(2.0, lambda: _sh("reboot")).start()
        return {"ok": True, "message": f"rebooting to BootNext={target}"}

    if action == "reboot":
        threading.Timer(2.0, lambda: _sh("reboot")).start()
        return {"ok": True, "message": "rebooting in 2s"}

    if action == "poweroff":
        threading.Timer(2.0, lambda: _sh("poweroff")).start()
        return {"ok": True, "message": "powering off in 2s"}

    if action == "mount":
        err = need_scanning()
        if err:
            return err
        dev = body.get("device", "")
        mp  = body.get("mountpoint", "/mnt/host")
        if not dev:
            return {"ok": False, "error": "missing device"}
        if not re.match(r"^/dev/[a-z0-9]+$", dev):
            return {"ok": False, "error": "invalid device path"}
        if not re.match(r"^/mnt/[a-zA-Z0-9_-]+$", mp):
            return {"ok": False, "error": "mountpoint must be under /mnt/"}
        _sh(f"mkdir -p {mp}")
        out = _sh(f"mount -o ro {dev} {mp} 2>&1")
        return {"ok": "error" not in out.lower(), "output": out, "mountpoint": mp}

    if action == "umount":
        mp = body.get("mountpoint", "/mnt/host")
        if not re.match(r"^/mnt/[a-zA-Z0-9_-]+$", mp):
            return {"ok": False, "error": "invalid mountpoint"}
        return {"ok": True, "output": _sh(f"umount {mp} 2>&1")}

    return {"ok": False, "error": f"unknown action: {action!r}"}


# ── HTTP handler ──────────────────────────────────────────────────────────────

class SentryHandler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        ts  = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        src = self.client_address[0]
        print(f"[{ts}] {src} {fmt % args}", flush=True)

    def _send(self, code: int, data: dict, extra_headers: dict | None = None):
        body = json.dumps(data).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", len(body))
        if extra_headers:
            for k, v in extra_headers.items():
                self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def _reject(self, msg: str, client_ip: str):
        code = 403 if "not in allowed_subnets" in msg else 401
        self._send(code, {"ok": False, "error": msg, "proto": "axiom-sentry/1"})

    # ── unauthenticated ───────────────────────────────────────────────────────

    def _handle_health(self):
        self._send(200, {"ok": True, "hostname": _hostname(), "proto": "axiom-sentry/1"})

    def _handle_challenge(self):
        data = issue_challenge(_PUBKEY_HEX)
        self._send(200, data)

    def _handle_handshake(self):
        length = int(self.headers.get("Content-Length", 0))
        try:
            body = json.loads(self.rfile.read(length))
        except Exception:
            self._send(400, {"ok": False, "error": "invalid JSON"})
            return

        nonce     = body.get("nonce", "")
        broker_id = body.get("broker_id", "unknown")

        token, resp = complete_handshake(
            nonce, broker_id, _PRIVKEY, _PUBKEY_HEX, _SESSION_SEC
        )
        code = 200 if token else 401
        # If handshake succeeded, tell broker to use Axiom header going forward
        headers = {"X-Axiom-Auth": "Axiom <session_token>"} if token else None
        self._send(code, resp, headers)

    # ── authenticated ─────────────────────────────────────────────────────────

    def _handle_state(self, session_token):
        resp = _full_state()
        if session_token and session_needs_refresh(session_token):
            resp["_hint"] = "session expiring soon — re-handshake recommended"
        self._send(200, resp)

    def _handle_action(self, session_token):
        length = int(self.headers.get("Content-Length", 0))
        try:
            body = json.loads(self.rfile.read(length))
        except Exception:
            self._send(400, {"ok": False, "error": "invalid JSON"})
            return
        result = _do_action(body)
        if session_token and session_needs_refresh(session_token):
            result["_hint"] = "session expiring soon — re-handshake recommended"
        self._send(200 if result.get("ok") else 400, result)

    # ── routing ───────────────────────────────────────────────────────────────

    def do_GET(self):
        if self.path == "/health":
            self._handle_health(); return
        if self.path == "/challenge":
            self._handle_challenge(); return

        ok, msg, tok = _check_auth(self)
        if not ok:
            self._reject(msg, self.client_address[0]); return

        if self.path == "/state":
            self._handle_state(tok)
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        if self.path == "/handshake":
            self._handle_handshake(); return

        ok, msg, tok = _check_auth(self)
        if not ok:
            self._reject(msg, self.client_address[0]); return

        if self.path == "/action":
            self._handle_action(tok)
        else:
            self._send(404, {"error": "not found"})


# ── UAI broker registration ───────────────────────────────────────────────────

def _register_to_broker(retries=12, delay=10):
    if not UAI_BROKER:
        print("[sentry-agent] no UAI_BROKER — skipping registration")
        return

    payload = json.dumps({
        "type":         "sentry",
        "proto":        "axiom-sentry/1",
        "hostname":     _hostname(),
        "ip":           _my_ip(),
        "agent_port":   AGENT_PORT,
        "node_pubkey":  _PUBKEY_HEX or "",
        "bearer_token": _BEARER_TOKEN or "",   # fallback for brokers without Axiom handshake
        "capabilities": ["disk", "boot", "power", "os-probe", "smart"],
        "mode":         "rescue",
    }).encode()

    for attempt in range(retries):
        try:
            req = Request(
                f"http://{UAI_BROKER}/sentry/register",
                data=payload,
                headers={"Content-Type": "application/json"},
                method="POST",
            )
            with urlopen(req, timeout=5) as resp:
                print(f"[sentry-agent] registered to UAI: {resp.read().decode()[:80]}")
                return
        except Exception as e:
            print(f"[sentry-agent] broker reg attempt {attempt+1}/{retries}: {e}")
            if attempt < retries - 1:
                time.sleep(delay)

    print("[sentry-agent] broker unreachable — running standalone (SSH still works)")


# ── bearer token loader ───────────────────────────────────────────────────────

def _load_bearer_token() -> str | None:
    try:
        tok = open(TOKEN_FILE).read().strip()
        if tok:
            return tok
    except FileNotFoundError:
        pass

    # Auto-generate if not configured
    tok = secrets.token_hex(32)
    os.makedirs(os.path.dirname(TOKEN_FILE), exist_ok=True)
    with open(TOKEN_FILE, "w") as f:
        f.write(tok + "\n")
    os.chmod(TOKEN_FILE, 0o600)
    try:
        with open(STATUS_FILE, "a") as f:
            f.write(f"\n Bearer token (fallback): {tok}\n")
    except Exception:
        pass
    print(f"[sentry-agent] auto-generated bearer token (written to {TOKEN_FILE} + STATUS.TXT)")
    return tok


def _load_subnets() -> list:
    nets = []
    try:
        import ipaddress
        for line in open(SUBNET_FILE):
            line = line.strip()
            if line and not line.startswith("#"):
                try:
                    nets.append(ipaddress.ip_network(line, strict=False))
                except ValueError:
                    pass
    except FileNotFoundError:
        pass
    return nets


# ── main ──────────────────────────────────────────────────────────────────────

if __name__ == "__main__":
    global _PRIVKEY, _PUBKEY_HEX, _SESSION_SEC, _BEARER_TOKEN, _SUBNETS

    import ipaddress  # needed by _load_subnets closure

    _PRIVKEY, _PUBKEY_HEX = load_or_generate_identity()
    _SESSION_SEC           = load_or_generate_session_secret()
    _BEARER_TOKEN          = _load_bearer_token()
    _SUBNETS               = _load_subnets()

    print(f"[sentry-agent] starting  port={AGENT_PORT}")
    print(f"[sentry-agent] identity  pubkey={(_PUBKEY_HEX or 'none')[:16]}…")
    print(f"[sentry-agent] subnets   {[str(s) for s in _SUBNETS] or 'any'}")
    print(f"[sentry-agent] auth      Axiom handshake + Bearer fallback")

    threading.Thread(target=_register_to_broker, daemon=True).start()

    server = HTTPServer(("0.0.0.0", AGENT_PORT), SentryHandler)
    print(f"[sentry-agent] listening 0.0.0.0:{AGENT_PORT}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("[sentry-agent] stopping")
